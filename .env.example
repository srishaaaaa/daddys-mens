# Copy to `.env` and fill in real values.

# Full access: billing, order history, analytics.
ADMIN_PASSCODE=admin123

# Billing panel only.
STAFF_PASSCODE=staff123

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   
# Public https URL of this app (used in coupon links sent on WhatsApp). Leave empty to use the current page address.
NEXT_PUBLIC_SITE_URL=


# UPI details and the public website address are set in the app (Settings).
# SHOP_UPI_ID / SHOP_UPI_NAME / SHOP_UPI_PHONE / SHOP_UPI_QR_MINUTES still work as a fallback.
